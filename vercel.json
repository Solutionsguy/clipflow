{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install && cd dashboard && npm install",
  "buildCommand": "cd dashboard && npm run build",
  "outputDirectory": "dashboard/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://clipflow-nn5p.onrender.com/api/$1"
    },
    {
      "source": "/videos/(.*)",
      "destination": "https://clipflow-nn5p.onrender.com/videos/$1"
    },
    {
      "source": "/thumbnails/(.*)",
      "destination": "https://clipflow-nn5p.onrender.com/thumbnails/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "credentialless"
        }
      ]
    }
  ]
}
