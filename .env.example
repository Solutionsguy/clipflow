# ==============================================================================
# Clipflow Environment Variables
# ==============================================================================

# --- Frontend Settings ---
VITE_API_URL=https://your-backend-api.com

# --- Server & CORS Settings ---
PORT=8000
# Comma-separated list of allowed frontend origins (Vercel domain & localhost)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000,https://your-app.vercel.app

# --- Database & Auth ---
JWT_SECRET_KEY=super-secret-key-change-me-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REMEMBER_ME_DAYS=30
# Database path for SQLite (default: ./users.db)
DATABASE_PATH=users.db

# --- AWS S3 / Cloudflare R2 Storage (Recommended for remote hosting) ---
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=eu-west-3
AWS_S3_BUCKET=your-bucket-name
AWS_S3_PUBLIC_BUCKET=your-public-bucket-name
# Custom S3 / R2 endpoint URL (optional, for Cloudflare R2 or MinIO)
# AWS_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com

# --- AI & External Services ---
GEMINI_API_KEY=your_gemini_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# --- Job Processing ---
MAX_CONCURRENT_JOBS=5
DISABLE_YOUTUBE_URL=false

# --- YouTube cookies (optional — paste Netscape-format cookies to bypass bot detection) ---
# YOUTUBE_COOKIES=...
